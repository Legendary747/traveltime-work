# Copy to .env (ignored by git). Keep actual keys and locations out of source control.
# Use your own Google Maps Platform project with billing and Routes API enabled.
GOOGLE_MAPS_API_KEY=

# Recommended: copy config.example.json to config.local.json and pass
# --config config.local.json BEFORE the CLI command.
# Alternatively uncomment the line below to select it automatically.
# TRAVELTIME_CONFIG_FILE=config.local.json

# Environment-only configuration remains supported. Uncomment only the settings
# you want to override: explicit environment values take precedence over JSON.
# COMMUTE_HOME=
# COMMUTE_WORK=
# COMMUTE_TIMEZONE=Europe/Amsterdam
# MONITOR_WEEKDAYS=0,1,2,3,4
# AM_START=06:00
# AM_END=09:00
# PM_START=15:00
# PM_END=18:00
# SAMPLE_INTERVAL_MINUTES=3
# MAX_LATENESS_SECONDS=60
# MONTHLY_REQUEST_LIMIT=4500
# NDW_ENABLED=true
# NDW_CORRIDOR_METERS=250
# DELAY_THRESHOLD_MINUTES=15
# TRIP_THRESHOLD_MINUTES=75
# MONITOR_START_DATE=
# MONITOR_END_DATE=
# EXCLUDE_DATES=
