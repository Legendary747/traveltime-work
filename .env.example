# Copy to .env (ignored by git). Never commit actual keys or addresses.
GOOGLE_MAPS_API_KEY=
# Address text, "latitude,longitude", or "place_id:ChIJ..."
# Prefer the actual driveway/parking entrance.
COMMUTE_HOME=
COMMUTE_WORK=
# Fixed default: 3 minutes, weekdays 06:00-09:00 / 15:00-18:00 Amsterdam.
SAMPLE_INTERVAL_MINUTES=3
MAX_LATENESS_SECONDS=60
# This installation's conservative request ceiling, not an account-wide billing cap.
MONTHLY_REQUEST_LIMIT=4500
NDW_ENABLED=true
NDW_CORRIDOR_METERS=250
DELAY_THRESHOLD_MINUTES=15
TRIP_THRESHOLD_MINUTES=75
# Optional inclusive dates, YYYY-MM-DD. Empty means no date restriction.
MONITOR_START_DATE=
MONITOR_END_DATE=
# Comma-separated dates to skip; national holidays are NOT silently excluded.
EXCLUDE_DATES=
